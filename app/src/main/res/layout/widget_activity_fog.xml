<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_fog_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="14dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.15"
            android:text="† шаги"
            android:textColor="#AEB3B8"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/act_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:includeFontPadding="false"
            android:letterSpacing="-0.02"
            android:maxLines="1"
            android:text="0"
            android:textColor="#E3E5E8"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/act_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:letterSpacing="0.1"
            android:maxLines="2"
            android:text="0 км · 0 ккал"
            android:textColor="#AEB3B8"
            android:textSize="11sp" />
    </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/act_steps_bar"
                android:layout_width="30dp"
                android:layout_height="78dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/act_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="шаги"
                android:textColor="#AEB3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/act_calories_bar"
                android:layout_width="30dp"
                android:layout_height="78dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/act_calories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="ккал"
                android:textColor="#AEB3B8"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/act_active_bar"
                android:layout_width="30dp"
                android:layout_height="78dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/act_active"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="мин"
                android:textColor="#AEB3B8"
                android:textSize="10sp" />
        </LinearLayout>
</LinearLayout>
