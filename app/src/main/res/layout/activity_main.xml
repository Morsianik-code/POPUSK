<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="28dp"
        android:paddingEnd="20dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="4dp"
            android:text="@string/tagline" />

        <Switch
            android:id="@+id/pet_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/card"
            android:minHeight="64dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/pet_switch"
            android:textColor="@color/text"
            android:textSize="18sp" />

        <TextView
            style="@style/Hint"
            android:layout_marginTop="8dp"
            android:text="@string/hint_touch" />

        <TextView
            style="@style/Section"
            android:text="@string/section_perms" />

        <LinearLayout
            android:id="@+id/perms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            style="@style/Section"
            android:text="@string/section_look" />

        <TextView
            android:id="@+id/size_label"
            style="@style/Label" />

        <SeekBar
            android:id="@+id/size_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/speed_label"
            style="@style/Label" />

        <SeekBar
            android:id="@+id/speed_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:id="@+id/alpha_label"
            style="@style/Label" />

        <SeekBar
            android:id="@+id/alpha_seek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <CheckBox
            android:id="@+id/platforms_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/opt_platforms"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            style="@style/Hint"
            android:paddingStart="32dp"
            android:text="@string/opt_platforms_hint" />

        <CheckBox
            android:id="@+id/quiet_check"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/opt_quiet"
            android:textColor="@color/text"
            android:textSize="16sp" />

        <TextView
            style="@style/Hint"
            android:paddingStart="32dp"
            android:text="@string/opt_quiet_hint" />

        <Button
            android:id="@+id/skin_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:minHeight="56dp"
            android:text="@string/open_skin" />
    </LinearLayout>
</ScrollView>
