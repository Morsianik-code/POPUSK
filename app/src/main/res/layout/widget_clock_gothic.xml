<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gothic_dark"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="8dp"
    android:paddingEnd="14dp"
    android:paddingBottom="8dp">

    <TextClock
        android:id="@+id/clock_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/pirata_one"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="#E8E0D0"
        android:textSize="54sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/clock_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:format12Hour="EEE, d MMM"
            android:format24Hour="EEE, d MMM"
            android:maxLines="1"
            android:textColor="#B8963E"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/clock_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="2"
            android:text="7° · Пасмурно"
            android:textColor="#E8E0D0"
            android:textSize="13sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="120dp"
        android:layout_height="66dp"
        android:layout_marginStart="6dp">

        <ImageView
            android:id="@+id/clock_sun_arc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/clock_sun_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pirata_one"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="07:15"
                android:textColor="#E8E0D0"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/clock_sun_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:maxLines="1"
                android:text="восход"
                android:textColor="#B8963E"
                android:textSize="10sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
